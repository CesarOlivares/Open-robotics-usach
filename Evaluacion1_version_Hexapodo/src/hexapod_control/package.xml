<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hexapod_control</name>
  <version>0.1.0</version>
  <description>Cinemática de las patas, marcha trípode y teleoperación del hexápodo.</description>
  <maintainer email="228733522+CesarOlivares@users.noreply.github.com">Cesar Olivares Lavalovich</maintainer>
  <license>Apache-2.0</license>

  <!-- Nodos (gait_node, keyboard_teleop, joy_to_twist; etapas E4 y E6) -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>
  <!-- test_kinematics_urdf.py: procesa el modelo y encadena sus transformadas -->
  <test_depend>hexapod_description</test_depend>
  <test_depend>xacro</test_depend>
  <test_depend>python3-numpy</test_depend>
  <test_depend>ament_index_python</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

<?xml version="1.0"?>
<!--
  Parámetros geométricos, másicos y límites de Octavius.

  Es el ÚNICO archivo que hay que tocar para cambiar dimensiones o límites:
  el resto de los .xacro solo usa estas propiedades.

  Unidades SI (REP-103): metros, kilogramos, radianes, rad/s y N·m.

  Convención de la pose cero: con todas las articulaciones en 0 el brazo
  queda vertical, apuntando a +Z. Los eslabones se extienden a lo largo de
  su eje Z local, así que los giros de hombro, codo y muñeca son en torno a Y.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="PI" value="3.14159265359"/>

  <!-- ===== Base fija (disco atornillado a la mesa) ===== -->
  <xacro:property name="base_radius" value="0.08"/>
  <xacro:property name="base_height" value="0.05"/>
  <xacro:property name="base_mass"   value="1.0"/>

  <!-- ===== Torreta: gira con la base (articulación 1) ===== -->
  <xacro:property name="turret_radius" value="0.06"/>
  <xacro:property name="turret_height" value="0.06"/>
  <xacro:property name="turret_mass"   value="0.5"/>

  <!-- ===== Brazo (articulación 2 → 3) ===== -->
  <xacro:property name="upper_arm_length" value="0.25"/>
  <xacro:property name="upper_arm_width"  value="0.05"/>
  <xacro:property name="upper_arm_mass"   value="0.4"/>

  <!-- ===== Antebrazo (articulación 3 → 4) ===== -->
  <xacro:property name="forearm_length" value="0.20"/>
  <xacro:property name="forearm_width"  value="0.04"/>
  <xacro:property name="forearm_mass"   value="0.3"/>

  <!-- ===== Muñeca (articulación 4 → 5) ===== -->
  <xacro:property name="wrist_length" value="0.06"/>
  <xacro:property name="wrist_radius" value="0.018"/>
  <xacro:property name="wrist_mass"   value="0.1"/>

  <!-- ===== Garra ===== -->
  <xacro:property name="gripper_base_x"    value="0.03"/>
  <xacro:property name="gripper_base_y"    value="0.09"/>
  <xacro:property name="gripper_base_z"    value="0.02"/>
  <xacro:property name="gripper_base_mass" value="0.08"/>
  <xacro:property name="finger_x"    value="0.02"/>
  <xacro:property name="finger_y"    value="0.01"/>
  <xacro:property name="finger_z"    value="0.06"/>
  <xacro:property name="finger_mass" value="0.02"/>
  <!-- Separación de cada dedo respecto al centro con la garra cerrada -->
  <xacro:property name="finger_closed_offset" value="0.006"/>

  <!-- ===== Límites articulares =====
       lower/upper: recorrido [rad] (dedos: [m])
       velocity:    velocidad máxima [rad/s] (dedos: [m/s])
       effort:      torque máximo [N·m] (dedos: fuerza [N]) -->
  <xacro:property name="base_lower"     value="${-PI}"/>
  <xacro:property name="base_upper"     value="${PI}"/>
  <xacro:property name="shoulder_lower" value="${-PI/2}"/>
  <xacro:property name="shoulder_upper" value="${PI/2}"/>
  <xacro:property name="elbow_lower"    value="${-0.75*PI}"/>
  <xacro:property name="elbow_upper"    value="${0.75*PI}"/>
  <xacro:property name="wrist_pitch_lower" value="${-PI/2}"/>
  <xacro:property name="wrist_pitch_upper" value="${PI/2}"/>
  <xacro:property name="wrist_roll_lower"  value="${-PI}"/>
  <xacro:property name="wrist_roll_upper"  value="${PI}"/>
  <xacro:property name="gripper_lower"  value="0.0"/>    <!-- cerrada -->
  <xacro:property name="gripper_upper"  value="0.025"/>  <!-- abierta -->

  <xacro:property name="joint_velocity" value="1.5"/>
  <xacro:property name="joint_effort"   value="20.0"/>
  <xacro:property name="gripper_velocity" value="0.05"/>
  <xacro:property name="gripper_effort"   value="10.0"/>

  <!-- Amortiguamiento y fricción en las juntas: evitan oscilaciones en Gazebo -->
  <xacro:property name="joint_damping"  value="0.5"/>
  <xacro:property name="joint_friction" value="0.1"/>

</robot>

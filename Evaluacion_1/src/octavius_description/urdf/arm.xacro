<?xml version="1.0"?>
<!--
  Cadena cinemática del brazo: base fija + articulaciones 1 a 5.

    base_link ─(1) base_joint──────► turret_link       giro de cintura, eje Z
    turret_link ─(2) shoulder_joint─► upper_arm_link    hombro, eje Y
    upper_arm_link ─(3) elbow_joint─► forearm_link      codo, eje Y
    forearm_link ─(4) wrist_pitch_joint─► wrist_link    inclinación de muñeca, eje Y
    wrist_link ─(5) wrist_roll_joint─► gripper_base_link (en gripper.xacro)

  Cada <joint> define:
    origin: dónde está el eje de la articulación, medido desde el frame del padre
    axis:   eje de giro, expresado en el frame del hijo
    limit:  recorrido, velocidad y torque máximos (ver octavius_params.xacro)
    dynamics: amortiguamiento y fricción, usados solo por Gazebo

  Cada <link> tiene:
    visual:    lo que se dibuja (RViz y Gazebo)
    collision: la forma que usa la física para choques (aquí, la misma geometría)
    inertial:  masa e inercia (macros de inertial.xacro)
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Junta revoluta con los límites y la dinámica comunes a todo el brazo -->
  <xacro:macro name="arm_revolute" params="name parent child axis lower upper *origin">
    <joint name="${name}" type="revolute">
      <parent link="${parent}"/>
      <child link="${child}"/>
      <xacro:insert_block name="origin"/>
      <axis xyz="${axis}"/>
      <limit lower="${lower}" upper="${upper}" velocity="${joint_velocity}" effort="${joint_effort}"/>
      <dynamics damping="${joint_damping}" friction="${joint_friction}"/>
    </joint>
  </xacro:macro>

  <!-- Cilindro horizontal (eje Y) que representa el motor de una articulación -->
  <xacro:macro name="joint_hub" params="radius length">
    <visual>
      <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
      <geometry><cylinder radius="${radius}" length="${length}"/></geometry>
      <material name="octavius_dark"/>
    </visual>
  </xacro:macro>

  <xacro:macro name="octavius_arm" params="parent">

    <!-- ===== Base fija ===== -->
    <joint name="base_fixed_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="base_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="base_link">
      <visual>
        <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
        <geometry><cylinder radius="${base_radius}" length="${base_height}"/></geometry>
        <material name="octavius_dark"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
        <geometry><cylinder radius="${base_radius}" length="${base_height}"/></geometry>
      </collision>
      <xacro:cylinder_inertial m="${base_mass}" r="${base_radius}" h="${base_height}">
        <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
      </xacro:cylinder_inertial>
    </link>

    <!-- ===== (1) Giro de la base ===== -->
    <xacro:arm_revolute name="base_joint" parent="base_link" child="turret_link"
                        axis="0 0 1" lower="${base_lower}" upper="${base_upper}">
      <origin xyz="0 0 ${base_height}" rpy="0 0 0"/>
    </xacro:arm_revolute>

    <link name="turret_link">
      <visual>
        <origin xyz="0 0 ${turret_height/2}" rpy="0 0 0"/>
        <geometry><cylinder radius="${turret_radius}" length="${turret_height}"/></geometry>
        <material name="octavius_orange"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${turret_height/2}" rpy="0 0 0"/>
        <geometry><cylinder radius="${turret_radius}" length="${turret_height}"/></geometry>
      </collision>
      <xacro:cylinder_inertial m="${turret_mass}" r="${turret_radius}" h="${turret_height}">
        <origin xyz="0 0 ${turret_height/2}" rpy="0 0 0"/>
      </xacro:cylinder_inertial>
    </link>

    <!-- ===== (2) Hombro ===== -->
    <xacro:arm_revolute name="shoulder_joint" parent="turret_link" child="upper_arm_link"
                        axis="0 1 0" lower="${shoulder_lower}" upper="${shoulder_upper}">
      <origin xyz="0 0 ${turret_height}" rpy="0 0 0"/>
    </xacro:arm_revolute>

    <link name="upper_arm_link">
      <xacro:joint_hub radius="${upper_arm_width*0.6}" length="${upper_arm_width*1.3}"/>
      <visual>
        <origin xyz="0 0 ${upper_arm_length/2}" rpy="0 0 0"/>
        <geometry><box size="${upper_arm_width} ${upper_arm_width} ${upper_arm_length}"/></geometry>
        <material name="octavius_orange"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${upper_arm_length/2}" rpy="0 0 0"/>
        <geometry><box size="${upper_arm_width} ${upper_arm_width} ${upper_arm_length}"/></geometry>
      </collision>
      <xacro:box_inertial m="${upper_arm_mass}" x="${upper_arm_width}" y="${upper_arm_width}" z="${upper_arm_length}">
        <origin xyz="0 0 ${upper_arm_length/2}" rpy="0 0 0"/>
      </xacro:box_inertial>
    </link>

    <!-- ===== (3) Codo ===== -->
    <xacro:arm_revolute name="elbow_joint" parent="upper_arm_link" child="forearm_link"
                        axis="0 1 0" lower="${elbow_lower}" upper="${elbow_upper}">
      <origin xyz="0 0 ${upper_arm_length}" rpy="0 0 0"/>
    </xacro:arm_revolute>

    <link name="forearm_link">
      <xacro:joint_hub radius="${forearm_width*0.65}" length="${forearm_width*1.4}"/>
      <visual>
        <origin xyz="0 0 ${forearm_length/2}" rpy="0 0 0"/>
        <geometry><box size="${forearm_width} ${forearm_width} ${forearm_length}"/></geometry>
        <material name="octavius_orange"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${forearm_length/2}" rpy="0 0 0"/>
        <geometry><box size="${forearm_width} ${forearm_width} ${forearm_length}"/></geometry>
      </collision>
      <xacro:box_inertial m="${forearm_mass}" x="${forearm_width}" y="${forearm_width}" z="${forearm_length}">
        <origin xyz="0 0 ${forearm_length/2}" rpy="0 0 0"/>
      </xacro:box_inertial>
    </link>

    <!-- ===== (4) Muñeca: inclinación (pitch) ===== -->
    <xacro:arm_revolute name="wrist_pitch_joint" parent="forearm_link" child="wrist_link"
                        axis="0 1 0" lower="${wrist_pitch_lower}" upper="${wrist_pitch_upper}">
      <origin xyz="0 0 ${forearm_length}" rpy="0 0 0"/>
    </xacro:arm_revolute>

    <link name="wrist_link">
      <xacro:joint_hub radius="${wrist_radius*1.2}" length="${wrist_radius*2.6}"/>
      <visual>
        <origin xyz="0 0 ${wrist_length/2}" rpy="0 0 0"/>
        <geometry><cylinder radius="${wrist_radius}" length="${wrist_length}"/></geometry>
        <material name="octavius_grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${wrist_length/2}" rpy="0 0 0"/>
        <geometry><cylinder radius="${wrist_radius}" length="${wrist_length}"/></geometry>
      </collision>
      <xacro:cylinder_inertial m="${wrist_mass}" r="${wrist_radius}" h="${wrist_length}">
        <origin xyz="0 0 ${wrist_length/2}" rpy="0 0 0"/>
      </xacro:cylinder_inertial>
    </link>

  </xacro:macro>

</robot>

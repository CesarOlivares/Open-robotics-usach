<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>octavius_description</name>
  <version>0.1.0</version>
  <description>Modelo URDF/XACRO del brazo manipulador Octavius (6 articulaciones) y su visualización en RViz.</description>
  <maintainer email="228733522+CesarOlivares@users.noreply.github.com">Cesar Olivares Lavalovich</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Procesar el .xacro y publicar el modelo y sus transformadas -->
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <!-- Sliders para mover las articulaciones sin simulador -->
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
